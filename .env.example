# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Internal render route token (used by the Playwright PDF pipeline and the
# preview iframe to authenticate against src/app/internal/render/[invoiceId])
INTERNAL_RENDER_TOKEN_SECRET="generate-with-openssl-rand-base64-32"

# Webhook outbound signing (default/fallback; per-endpoint secrets are stored
# in the WebhookEndpoint table)
WEBHOOK_DEFAULT_SIGNING_SECRET=""

# Shared secret the inbound gateway callback receiver (POST /api/v1/webhooks)
# requires on the X-Webhook-Secret header, since that route has no session to
# authenticate against — it's called by an external payment gateway.
INBOUND_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Seed script (prisma/seed.ts) — the initial OWNER account. Defaults to
# owner@example.com / changeme123 if unset, which is fine for local dev but
# must be overridden before seeding a real deployment (there is no in-app
# password-change feature yet — user/account management is out of V1 scope
# per plan.md — so this is the only way to set a real initial password).
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""

# App
NODE_ENV="development"

# Pino log level — defaults to "debug" outside production, "info" in it.
LOG_LEVEL=""
