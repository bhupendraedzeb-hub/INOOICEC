# Database
# Local/dev: point at localhost. Under docker-compose: the app container
# reaches Postgres at the service name "postgres", not "localhost" — see
# docker-compose.yml, which overrides this value automatically from the
# POSTGRES_* vars below, so you don't need to hand-edit it for compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice?schema=public"

# docker-compose only: credentials for the "postgres" service. Unused
# outside Docker (plain `pnpm dev` reads DATABASE_URL directly instead).
POSTGRES_USER="invoice"
POSTGRES_PASSWORD="generate-a-real-password"
POSTGRES_DB="invoice"

# docker-compose only: host port the app is published on (container always
# listens on 3000 internally).
APP_PORT="3000"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# "Continue with Google" on /login and /signup. Create an OAuth 2.0 Client ID
# in Google Cloud Console (APIs & Services > Credentials) with authorized
# redirect URI {AUTH_URL}/api/auth/callback/google. A first-time Google
# sign-in auto-provisions a brand-new Organization (the user becomes its
# OWNER) exactly like /signup does — see provisionOrganizationAndOwner in
# src/lib/services/organizations.ts.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Internal render route token (used by the Playwright PDF pipeline and the
# preview iframe to authenticate against src/app/internal/render/[invoiceId])
INTERNAL_RENDER_TOKEN_SECRET="generate-with-openssl-rand-base64-32"

# Webhook outbound signing (default/fallback; per-endpoint secrets are stored
# in the WebhookEndpoint table)
WEBHOOK_DEFAULT_SIGNING_SECRET=""

# Shared secret the inbound gateway callback receiver (POST /api/v1/webhooks)
# requires on the X-Webhook-Secret header, since that route has no session to
# authenticate against — it's called by an external payment gateway.
INBOUND_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Seed script (prisma/seed.ts) — creates the bootstrap Organization plus its
# initial OWNER account (same signupOrganization() logic /signup uses).
# Defaults to owner@example.com / changeme123 / "Default Organization" if
# unset, fine for local dev but should be overridden before seeding a real
# deployment. Only matters for this one bootstrap run — real organizations
# and users after that are created via /signup and Settings > Team.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD=""
SEED_ORGANIZATION_NAME="Default Organization"

# App
NODE_ENV="development"

# Pino log level — defaults to "debug" outside production, "info" in it.
LOG_LEVEL=""
