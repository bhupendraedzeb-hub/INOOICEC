# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice?schema=public"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Internal render route token (used by the Playwright PDF pipeline and the
# preview iframe to authenticate against src/app/internal/render/[invoiceId])
INTERNAL_RENDER_TOKEN_SECRET="generate-with-openssl-rand-base64-32"

# Webhook outbound signing (default/fallback; per-endpoint secrets are stored
# in the WebhookEndpoint table)
WEBHOOK_DEFAULT_SIGNING_SECRET=""

# App
NODE_ENV="development"
