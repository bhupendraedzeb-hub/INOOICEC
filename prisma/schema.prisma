// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 — Core Application Foundation
// (Customer/Product/Template/Invoice/Payment/Webhook models land in later phases)
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  // Bumped to invalidate all outstanding JWT sessions for this user (revocation
  // substitute — Auth.js v5 rejects `session.strategy = "database"` for a
  // credentials-only provider set, so sessions are JWT-based; see auth.ts).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]
  apiKeys   ApiKey[]
}

// NextAuth.js (Auth.js) v5 required models — Prisma adapter, database sessions.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Singleton row (one CompanySettings record per deployment).
model CompanySettings {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String? // used for CGST/SGST vs IGST determination
  postalCode   String?
  country      String?

  gstin   String?
  pan     String?
  phone   String?
  email   String?
  website String?

  bankName          String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  currency            String  @default("INR")
  invoicePrefix       String  @default("INV")
  invoiceNumberFormat String  @default("{prefix}-{fy}-{seq}")
  defaultPaymentTerms String?
  defaultNotes        String?
  defaultTerms        String?

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "invoice.issued", "payment.voided", "template.version_created"
  entityType String // "Invoice", "Payment", "Template", ...
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  label       String
  hashedKey   String    @unique // argon2 hash of the secret; plaintext shown once on creation only
  prefix      String // short visible prefix, e.g. "inv_live_ab12", for identification in UI
  scopes      String[] // e.g. ["invoices:write", "invoices:read", "payments:write"]
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}
