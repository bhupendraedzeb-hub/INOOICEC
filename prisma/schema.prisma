// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 — Core Application Foundation
// (Customer/Product/Template/Invoice/Payment/Webhook models land in later phases)
// ---------------------------------------------------------------------------

// A tenant boundary. Every other business-data model below (company
// settings, customers, products, templates, invoices, payments, API keys,
// webhooks, audit logs) hangs off exactly one Organization, and no query
// anywhere is allowed to cross that boundary — see lib/services/*.ts, which
// take an organizationId as an explicit required parameter throughout.
// Deliberately thin: no slug, no billing, no nested sub-orgs — this is
// tenant data-isolation for a private self-hosted tool, not a SaaS product
// (see agent/AGENTS.md).
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  companySettings       CompanySettings?
  auditLogs             AuditLog[]
  customers             Customer[]
  products              Product[]
  templates             Template[]
  apiKeys               ApiKey[]
  invoices              Invoice[]
  invoiceNumberCounters InvoiceNumberCounter[]
  payments              Payment[]
  paymentLinks          PaymentLink[]
  webhookEndpoints      WebhookEndpoint[]
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String   @unique
  name           String
  passwordHash   String
  role           UserRole @default(STAFF)
  isActive       Boolean  @default(true)
  // Bumped to invalidate all outstanding JWT sessions for this user (revocation
  // substitute — Auth.js v5 rejects `session.strategy = "database"` for a
  // credentials-only provider set, so sessions are JWT-based; see auth.ts).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  accounts                Account[]
  sessions                Session[]
  auditLogs               AuditLog[]
  apiKeys                 ApiKey[]
  createdTemplates        Template[]        @relation("TemplateCreatedBy")
  createdVersions         TemplateVersion[] @relation("TemplateVersionCreatedBy")
  createdInvoices         Invoice[]         @relation("InvoiceCreatedBy")
  recordedPayments        Payment[]
  createdPaymentLinks     PaymentLink[]
  createdWebhookEndpoints WebhookEndpoint[]

  @@index([organizationId])
}

// NextAuth.js (Auth.js) v5 required models — Prisma adapter, database sessions.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One CompanySettings record per Organization (organizationId unique below
// enforces this — previously a per-deployment singleton with no DB-level
// constraint at all, before multi-tenancy).
model CompanySettings {
  id             String @id @default(cuid())
  organizationId String @unique
  name           String
  logoUrl        String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String? // used for CGST/SGST vs IGST determination
  postalCode   String?
  country      String?

  gstin   String?
  pan     String?
  phone   String?
  email   String?
  website String?

  bankName          String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  currency            String  @default("INR")
  invoicePrefix       String  @default("INV")
  invoiceNumberFormat String  @default("{prefix}-{fy}-{seq}")
  defaultPaymentTerms String?
  defaultNotes        String?
  defaultTerms        String?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

// actorId is nullable (the inbound gateway webhook receiver writes audit
// events with no session actor), so organizationId can't be derived from
// the actor — every writeAuditEvent() call site passes it explicitly,
// sourced from the entity being acted on.
model AuditLog {
  id             String  @id @default(cuid())
  organizationId String
  actorId        String?
  action     String // e.g. "invoice.issued", "payment.voided", "template.version_created"
  entityType String // "Invoice", "Payment", "Template", ...
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  actor        User?        @relation(fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Customers & Products (reusable master data for invoice creation)
// ---------------------------------------------------------------------------

model Customer {
  id              String  @id @default(cuid())
  organizationId  String
  name            String
  companyName     String?
  gstin           String?
  pan             String?
  billingAddress  String?
  shippingAddress String?
  state           String?
  stateCode       String?
  phone           String?
  email           String?
  isArchived      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]

  @@index([organizationId])
  @@index([name])
}

model Product {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?
  hsnSac         String?
  defaultRate    Decimal @db.Decimal(14, 2)
  gstRate        Decimal @db.Decimal(5, 2)
  unit           String?
  isArchived     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([name])
}

// ---------------------------------------------------------------------------
// Phase 4 — Template Data Model
// ---------------------------------------------------------------------------

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Template {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  thumbnailUrl   String?
  status         TemplateStatus @default(DRAFT)
  // Per-organization default — createTemplate/updateTemplateMetadata's
  // "unset every other default" reset must scope by organizationId, or it
  // would silently unset another organization's default template.
  isDefault Boolean @default(false)

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  createdBy    User              @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  versions     TemplateVersion[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([status])
}

// Insert-only: a version, once created, is never updated or deleted (see
// src/lib/services/templates.ts — there is deliberately no
// updateTemplateVersion function). Once Invoices exist (Phase 9), issued
// invoices pin a templateVersionId so edits to a Template after that point
// can never retroactively change an already-issued invoice.
model TemplateVersion {
  id            String @id @default(cuid())
  templateId    String
  versionNumber Int
  layout        Json

  createdById String
  createdAt   DateTime @default(now())

  template  Template  @relation(fields: [templateId], references: [id])
  createdBy User      @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id])
  invoices  Invoice[]

  @@unique([templateId, versionNumber])
}

model ApiKey {
  id             String @id @default(cuid())
  organizationId String
  label          String
  hashedKey      String    @unique // argon2 hash of the secret; plaintext shown once on creation only
  prefix         String // short visible prefix, e.g. "inv_live_ab12", for identification in UI
  scopes         String[] // e.g. ["invoices:write", "invoices:read", "payments:write"]
  createdById    String
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  // Read directly (not derived via createdBy) when resolving an API-key
  // actor's org, so a key keeps working correctly even if its creator
  // later leaves the organization — see lib/auth/resolveRequestAuth.ts.
  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Phase 9 — Invoice Creation & Management
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

// Atomic, gap-safe invoice number reservation — one row per (prefix,
// financialYear). Incremented via Prisma upsert, which Postgres implements
// as INSERT ... ON CONFLICT DO UPDATE, safe under concurrent /issue calls
// without a separate SELECT ... FOR UPDATE.
model InvoiceNumberCounter {
  id             String @id @default(cuid())
  organizationId String
  prefix         String
  financialYear  String
  lastSequence   Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, prefix, financialYear])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  // null while DRAFT; assigned only at /issue. Scoped per-organization, not
  // globally unique — every org's numbering starts at its own prefix/FY
  // sequence (see @@unique below), so two orgs both issuing their first
  // invoice of the year both get e.g. "INV-2026-0001" without colliding.
  invoiceNumber String?
  status        InvoiceStatus @default(DRAFT)
  // Cached/derived (lib/calc/gstEngine.ts's derivePaymentStatus), recomputed
  // transactionally on every totals/payment write — never hand-editable, so
  // a paid invoice can't silently flip via an unrelated UI change.
  paymentStatus PaymentStatus @default(UNPAID)

  templateId        String
  template          Template         @relation(fields: [templateId], references: [id])
  // Set only at /issue; immutable thereafter. PDFs for issued invoices (Phase
  // 12) always render from this pinned version, never the template's current
  // (possibly since-edited) state.
  templateVersionId String?
  templateVersion   TemplateVersion? @relation(fields: [templateVersionId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  issueDate DateTime?
  dueDate   DateTime?

  currency String @default("INR")

  // Server-computed only (lib/calc/gstEngine.ts) — API layer must ignore any
  // client-sent values for these fields.
  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  roundOff      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  // Cached sum of Payment.amount (Phase 10 adds real writes to these; both
  // default to 0/grandTotal until then since no Payment model exists yet).
  paidTotal     Decimal @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal @default(0) @db.Decimal(14, 2)

  notes String?
  terms String?

  createdById     String
  createdBy       User      @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  paymentLinks PaymentLink[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  productId   String?
  description String
  hsnSac      String?
  quantity    Decimal @db.Decimal(14, 3)
  unit        String?
  rate        Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2) // per-line discount amount
  gstRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2) // server-computed
  lineTotal   Decimal @default(0) @db.Decimal(14, 2) // server-computed
}

// ---------------------------------------------------------------------------
// Phase 10 — Payment Tracking
// ---------------------------------------------------------------------------

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  CASH
  GATEWAY
  OTHER
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  paymentDate    DateTime
  method         PaymentMethod
  transactionRef String?
  notes          String?
  // Voided, never deleted — a financial record. Invoice.paidTotal only sums
  // non-voided payments (see lib/services/payments.ts recomputeInvoicePaymentState).
  isVoided       Boolean       @default(false)
  voidedAt       DateTime?
  voidedReason   String?

  // Set only when this payment was created by the Phase 11 inbound webhook
  // receiver from a PaymentLink gateway callback (null for manually recorded
  // payments). The unique constraint is the DB-enforced idempotency backstop
  // that guarantees the same gateway transaction can never create a second
  // Payment row, even under a duplicated/retried webhook delivery.
  paymentLinkId        String?
  paymentLink          PaymentLink? @relation(fields: [paymentLinkId], references: [id])
  gatewayTransactionId String?      @unique

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  // Added in Phase 15 for lib/webhooks/dispatch.ts's idempotency key
  // (payment.updated needs a version that actually changes between two
  // edits of the same payment — createdAt alone would collide).
  updatedAt   DateTime @updatedAt

  @@index([organizationId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Phase 11 — Payment Links
// ---------------------------------------------------------------------------

enum PaymentLinkStatus {
  ACTIVE
  PAID
  EXPIRED
  DEACTIVATED
}

model PaymentLink {
  id             String @id @default(cuid())
  organizationId String
  // Opaque public identifier (e.g. a future /pay/:token page or the value
  // handed to a payment gateway when creating its side of the link) —
  // deliberately not the row id, so the internal cuid never needs to be
  // exposed to a customer-facing surface. Globally unique/unguessable, so
  // the inbound webhook receiver (no session/org context) can safely use
  // it alone as the lookup key without an explicit org check.
  token        String            @unique @default(cuid())
  invoiceId    String
  organization Organization      @relation(fields: [organizationId], references: [id])
  invoice      Invoice           @relation(fields: [invoiceId], references: [id])
  amount       Decimal           @db.Decimal(14, 2)
  // Free-text gateway label (e.g. "razorpay", "stripe", "manual") — kept
  // generic per plan.md: no vendor-specific fields or hardcoded integrations.
  provider  String
  status    PaymentLinkStatus @default(ACTIVE)
  expiresAt DateTime?

  // Set once the inbound webhook matches a successful gateway callback to
  // this link (see lib/services/paymentLinks.ts recordWebhookPayment).
  externalPaymentId String?
  paidAt            DateTime?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]

  @@index([organizationId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Phase 15 — Webhooks & Integrations
// ---------------------------------------------------------------------------

model WebhookEndpoint {
  id             String @id @default(cuid())
  organizationId String
  url            String
  label          String?
  // Subset of lib/webhooks/events.ts's WEBHOOK_EVENTS — an endpoint only
  // ever receives deliveries for events it's subscribed to.
  events   String[]
  isActive Boolean  @default(true)

  // Generated at creation, shown once (same UX as ApiKey's plaintext
  // secret) — HMAC-SHA256 signs every delivery to this endpoint. Falls
  // back to WEBHOOK_DEFAULT_SIGNING_SECRET if somehow unset (see
  // lib/webhooks/signature.ts), but the create flow always populates it.
  signingSecret String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  EXHAUSTED
}

model WebhookDelivery {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id])

  event   String // e.g. "invoice.issued"
  payload Json

  // Derived from (endpointId, event, entityId, the triggering write's
  // updatedAt) by lib/webhooks/dispatch.ts — the DB-constraint-backed
  // idempotency guarantee that the same state change is never enqueued
  // twice for the same endpoint, the same pattern Phase 11's
  // Payment.gatewayTransactionId uses for inbound idempotency.
  idempotencyKey String @unique

  status        WebhookDeliveryStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastAttemptAt DateTime?
  // When the worker (lib/webhooks/worker.ts) should next try a
  // PENDING/FAILED delivery — null means "due now".
  nextAttemptAt DateTime?

  responseStatus Int?
  responseBody   String? // truncated
  error          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([endpointId])
  @@index([status, nextAttemptAt])
}
