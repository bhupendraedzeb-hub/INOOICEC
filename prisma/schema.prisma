// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 — Core Application Foundation
// (Customer/Product/Template/Invoice/Payment/Webhook models land in later phases)
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STAFF)
  isActive     Boolean  @default(true)
  // Bumped to invalidate all outstanding JWT sessions for this user (revocation
  // substitute — Auth.js v5 rejects `session.strategy = "database"` for a
  // credentials-only provider set, so sessions are JWT-based; see auth.ts).
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  auditLogs        AuditLog[]
  apiKeys          ApiKey[]
  createdTemplates Template[]        @relation("TemplateCreatedBy")
  createdVersions  TemplateVersion[] @relation("TemplateVersionCreatedBy")
  createdInvoices  Invoice[]         @relation("InvoiceCreatedBy")
}

// NextAuth.js (Auth.js) v5 required models — Prisma adapter, database sessions.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Singleton row (one CompanySettings record per deployment).
model CompanySettings {
  id      String  @id @default(cuid())
  name    String
  logoUrl String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  stateCode    String? // used for CGST/SGST vs IGST determination
  postalCode   String?
  country      String?

  gstin   String?
  pan     String?
  phone   String?
  email   String?
  website String?

  bankName          String?
  bankAccountHolder String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  currency            String  @default("INR")
  invoicePrefix       String  @default("INV")
  invoiceNumberFormat String  @default("{prefix}-{fy}-{seq}")
  defaultPaymentTerms String?
  defaultNotes        String?
  defaultTerms        String?

  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. "invoice.issued", "payment.voided", "template.version_created"
  entityType String // "Invoice", "Payment", "Template", ...
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Customers & Products (reusable master data for invoice creation)
// ---------------------------------------------------------------------------

model Customer {
  id              String  @id @default(cuid())
  name            String
  companyName     String?
  gstin           String?
  pan             String?
  billingAddress  String?
  shippingAddress String?
  state           String?
  stateCode       String?
  phone           String?
  email           String?
  isArchived      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@index([name])
}

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  hsnSac      String?
  defaultRate Decimal @db.Decimal(14, 2)
  gstRate     Decimal @db.Decimal(5, 2)
  unit        String?
  isArchived  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

// ---------------------------------------------------------------------------
// Phase 4 — Template Data Model
// ---------------------------------------------------------------------------

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Template {
  id           String         @id @default(cuid())
  name         String
  description  String?
  thumbnailUrl String?
  status       TemplateStatus @default(DRAFT)
  isDefault    Boolean        @default(false)

  createdById String
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User              @relation("TemplateCreatedBy", fields: [createdById], references: [id])
  versions  TemplateVersion[]
  invoices  Invoice[]

  @@index([status])
}

// Insert-only: a version, once created, is never updated or deleted (see
// src/lib/services/templates.ts — there is deliberately no
// updateTemplateVersion function). Once Invoices exist (Phase 9), issued
// invoices pin a templateVersionId so edits to a Template after that point
// can never retroactively change an already-issued invoice.
model TemplateVersion {
  id            String @id @default(cuid())
  templateId    String
  versionNumber Int
  layout        Json

  createdById String
  createdAt   DateTime @default(now())

  template  Template  @relation(fields: [templateId], references: [id])
  createdBy User      @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id])
  invoices  Invoice[]

  @@unique([templateId, versionNumber])
}

model ApiKey {
  id          String    @id @default(cuid())
  label       String
  hashedKey   String    @unique // argon2 hash of the secret; plaintext shown once on creation only
  prefix      String // short visible prefix, e.g. "inv_live_ab12", for identification in UI
  scopes      String[] // e.g. ["invoices:write", "invoices:read", "payments:write"]
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

// ---------------------------------------------------------------------------
// Phase 9 — Invoice Creation & Management
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

// Atomic, gap-safe invoice number reservation — one row per (prefix,
// financialYear). Incremented via Prisma upsert, which Postgres implements
// as INSERT ... ON CONFLICT DO UPDATE, safe under concurrent /issue calls
// without a separate SELECT ... FOR UPDATE.
model InvoiceNumberCounter {
  id            String @id @default(cuid())
  prefix        String
  financialYear String
  lastSequence  Int    @default(0)

  @@unique([prefix, financialYear])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String?       @unique // null while DRAFT; assigned only at /issue
  status        InvoiceStatus @default(DRAFT)
  // Cached/derived (lib/calc/gstEngine.ts's derivePaymentStatus), recomputed
  // transactionally on every totals/payment write — never hand-editable, so
  // a paid invoice can't silently flip via an unrelated UI change.
  paymentStatus PaymentStatus @default(UNPAID)

  templateId        String
  template          Template         @relation(fields: [templateId], references: [id])
  // Set only at /issue; immutable thereafter. PDFs for issued invoices (Phase
  // 12) always render from this pinned version, never the template's current
  // (possibly since-edited) state.
  templateVersionId String?
  templateVersion   TemplateVersion? @relation(fields: [templateVersionId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  issueDate DateTime?
  dueDate   DateTime?

  currency String @default("INR")

  // Server-computed only (lib/calc/gstEngine.ts) — API layer must ignore any
  // client-sent values for these fields.
  subtotal      Decimal @default(0) @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  taxableAmount Decimal @default(0) @db.Decimal(14, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(14, 2)
  igstTotal     Decimal @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal @default(0) @db.Decimal(14, 2)
  roundOff      Decimal @default(0) @db.Decimal(14, 2)
  grandTotal    Decimal @default(0) @db.Decimal(14, 2)
  // Cached sum of Payment.amount (Phase 10 adds real writes to these; both
  // default to 0/grandTotal until then since no Payment model exists yet).
  paidTotal     Decimal @default(0) @db.Decimal(14, 2)
  balanceDue    Decimal @default(0) @db.Decimal(14, 2)

  notes String?
  terms String?

  createdById     String
  createdBy       User      @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items InvoiceItem[]

  @@index([status])
  @@index([paymentStatus])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int
  productId   String?
  description String
  hsnSac      String?
  quantity    Decimal @db.Decimal(14, 3)
  unit        String?
  rate        Decimal @db.Decimal(14, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2) // per-line discount amount
  gstRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2) // server-computed
  lineTotal   Decimal @default(0) @db.Decimal(14, 2) // server-computed
}
